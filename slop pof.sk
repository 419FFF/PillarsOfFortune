    delete {pof.items.food::*}
    add wooden sword to {pof.items.weapons::*}
    add wooden sword to {pof.items.weapons::*}
    add stone sword to {pof.items.weapons::*}
    add stone sword to {pof.items.weapons::*}
    add gold sword to {pof.items.weapons::*}
    add iron sword to {pof.items.weapons::*}
    add wooden axe to {pof.items.weapons::*}
    add stone axe to {pof.items.weapons::*}
