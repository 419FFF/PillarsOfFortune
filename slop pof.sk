# ============================================================
#  PILLARS OF FORTUNE
#  Skript 2.2dev36  |  Spigot / Paper 1.8.8
# ============================================================
#  REQUIRED
#    Skript 2.2dev36 (bensku)
#    skRayFall 1.9.12 / 1.9.18 (1.8.8 build)
#  RECOMMENDED
#    ProtocolLib
#    server.properties: spawn-protection=0
#
#  STATS
#    One variable per player per stat:
#      {pof.stat.<uuid>.wins}  {pof.stat.<uuid>.kills}  etc.
#    Player index list: {pof.players::*}
#    After first load, run /pofwipe once to delete leftover
#    list-style variables from older versions (pof-wipe.sk).
# ============================================================

options:
    prefix: &8[&6PoF&8]&r
    world: world
    serverIP: example.com
    arenas: 6
    pillars: 12
    radius: 20
    pillarHeight: 45
    pillarY: 70
    voidY: 8
    arenaSize: 40
    buildRadius: 48
    clearRadius: 72
    clearHeight: 120
    maxBuildY: 120
    borderKill: 70
    minPlayers: 2
    maxPlayers: 12
    countdown: 15
    queueSeconds: 30
    itemSeconds: 5
    graceSeconds: 5
    endSeconds: 8
    maxGameSeconds: 600
    lobbyGamemode: adventure
    fireballSpeed: 10
    fireballAccel: 0.1
    fireballKBX: 1.15
    fireballKBY: 0.75
    fireballRadius: 3
    fireballCooldown: 0.5
    fireballDmgSelf: 0.5
    fireballDmgEnemy: 2.0
    blockMin: 4
    blockMax: 12
    pearlChance: 15
    # item pool weights (should add to 100)
    rateWeapons: 8
    rateArmor: 7
    rateBlocks: 72
    rateChaos: 13
    lobbyItem: nether star
    lobbyItemName: &6&lJoin Queue
    leaveItem: barrier
    leaveItemName: &c&lLeave Queue
    vipItem: diamond
    vipItemName: &6&lStart Match

# ------------------------------------------------------------
# Functions
# ------------------------------------------------------------

function pofPlayer(u: text) :: player:
    loop all players:
        if UUID of loop-player is {_u}:
            return loop-player

function pofWorld(n: number) :: world:
    set {_w} to world "{@world}"
    if {_w} is set:
        return {_w}
    loop all worlds:
        return loop-world

function pofArenaX(id: number) :: number:
    return {_id} * 2000

function pofArenaZ(id: number) :: number:
    return 0

function pofCenter(id: number) :: location:
    set {_w} to pofWorld(0)
    if {_w} is set:
        return location(pofArenaX({_id}), {@pillarY}, pofArenaZ({_id}), {_w})

function pofStat(u: text, key: text) :: number:
    if {_key} is "wins":
        set {_v} to {pof.stat.%{_u}%.wins}
        if {_v} is not set:
            set {_v} to {pof.wins::%{_u}%}
    else if {_key} is "kills":
        set {_v} to {pof.stat.%{_u}%.kills}
    else if {_key} is "deaths":
        set {_v} to {pof.stat.%{_u}%.deaths}
    else if {_key} is "games":
        set {_v} to {pof.stat.%{_u}%.games}
    else if {_key} is "streak":
        set {_v} to {pof.stat.%{_u}%.streak}
    else if {_key} is "beststreak":
        set {_v} to {pof.stat.%{_u}%.beststreak}
    else if {_key} is "items":
        set {_v} to {pof.stat.%{_u}%.items}
    else if {_key} is "playtime":
        set {_v} to {pof.stat.%{_u}%.playtime}
    if {_v} is not set:
        set {_v} to 0
    return {_v}

function pofAddStat(u: text, key: text, n: number):
    set {_v} to pofStat({_u}, {_key}) + {_n}
    if {_key} is "wins":
        set {pof.stat.%{_u}%.wins} to {_v}
    else if {_key} is "kills":
        set {pof.stat.%{_u}%.kills} to {_v}
    else if {_key} is "deaths":
        set {pof.stat.%{_u}%.deaths} to {_v}
    else if {_key} is "games":
        set {pof.stat.%{_u}%.games} to {_v}
    else if {_key} is "streak":
        set {pof.stat.%{_u}%.streak} to {_v}
    else if {_key} is "beststreak":
        set {pof.stat.%{_u}%.beststreak} to {_v}
    else if {_key} is "items":
        set {pof.stat.%{_u}%.items} to {_v}
    else if {_key} is "playtime":
        set {pof.stat.%{_u}%.playtime} to {_v}

function pofEnsureStats(p: player):
    set {_u} to UUID of {_p}
    set {pof.stat.%{_u}%.name} to "%{_p}%"
    set {pof.index::%{_u}%} to "%{_p}%"
    if {pof.stat.%{_u}%.wins} is not set:
        if {pof.wins::%{_u}%} is set:
            set {pof.stat.%{_u}%.wins} to {pof.wins::%{_u}%}
        else:
            set {pof.stat.%{_u}%.wins} to 0
    if {pof.stat.%{_u}%.kills} is not set:
        set {pof.stat.%{_u}%.kills} to 0
    if {pof.stat.%{_u}%.deaths} is not set:
        set {pof.stat.%{_u}%.deaths} to 0
    if {pof.stat.%{_u}%.games} is not set:
        set {pof.stat.%{_u}%.games} to 0
    if {pof.stat.%{_u}%.streak} is not set:
        set {pof.stat.%{_u}%.streak} to 0
    if {pof.stat.%{_u}%.beststreak} is not set:
        set {pof.stat.%{_u}%.beststreak} to 0
    if {pof.stat.%{_u}%.items} is not set:
        set {pof.stat.%{_u}%.items} to 0
    if {pof.stat.%{_u}%.playtime} is not set:
        set {pof.stat.%{_u}%.playtime} to 0

function pofMsg(p: player, t: text):
    send "{@prefix} %{_t}%" to {_p}

function pofLobbyMsg(t: text):
    loop all players:
        set {_u} to UUID of loop-player
        if {pof.player.arena::%{_u}%} is not set:
            if {pof.player.alive::%{_u}%} is not true:
                send "{@prefix} %{_t}%" to loop-player

function pofAMsg(id: number, t: text):
    loop {pof.arena.%{_id}%.players::*}:
        set {_p} to pofPlayer(loop-value)
        if {_p} is set:
            send "{@prefix} %{_t}%" to {_p}

function pofSound(p: player, s: text, pitch: number):
    play sound {_s} with volume 1 and pitch {_pitch} at {_p} for {_p}

function pofBlastPush(p: player, loc: location):
    if {_p} is not set:
        stop
    if {_loc} is not set:
        stop
    set {_dx} to x-coordinate of {_p} - x-coordinate of {_loc}
    set {_dz} to z-coordinate of {_p} - z-coordinate of {_loc}
    if {_dx} > 0.1:
        push {_p} east at speed {@fireballKBX}
    else if {_dx} < -0.1:
        push {_p} west at speed {@fireballKBX}
    if {_dz} > 0.1:
        push {_p} south at speed {@fireballKBX}
    else if {_dz} < -0.1:
        push {_p} north at speed {@fireballKBX}
    push {_p} upwards at speed {@fireballKBY}


function pofIsIllegal(i: itemtype) :: boolean:
    if {_i} is not set:
        return false
    set {_n} to "%{_i}%"
    if {_n} contains "bedrock":
        return true
    if {_n} contains "barrier":
        return true
    if {_n} contains "command block":
        return true
    if {_n} contains "command minecart":
        return true
    if {_n} contains "minecart with command":
        return true
    if {_n} contains "spawner":
        return true
    if {_n} contains "portal frame":
        return true
    if {_n} contains "ender portal":
        return true
    if {_n} contains "end portal":
        return true
    return false

function pofStripIllegal(p: player):
    loop all items in {_p}'s inventory:
        set {_nm} to name of loop-item
        if {_nm} is set:
            if {_nm} contains "Leave Queue":
                set {_skip} to 1
            else if {_nm} contains "Join Queue":
                set {_skip} to 1
            else if {_nm} contains "Start Match":
                set {_skip} to 1
            else:
                set {_skip} to 0
        else:
            set {_skip} to 0
        if {_skip} is 0:
            if pofIsIllegal(loop-item) is true:
                remove loop-item from {_p}
    if pofIsIllegal(helmet of {_p}) is true:
        set helmet of {_p} to air
    if pofIsIllegal(chestplate of {_p}) is true:
        set chestplate of {_p} to air
    if pofIsIllegal(leggings of {_p}) is true:
        set leggings of {_p} to air
    if pofIsIllegal(boots of {_p}) is true:
        set boots of {_p} to air

function pofGiveLobbyItem(p: player):
    if {_p} is not set:
        stop
    set slot 0 of {_p} to {@lobbyItem} named "{@lobbyItemName}"
    set slot 4 of {_p} to air
    set slot 8 of {_p} to air
    remove {@vipItem} named "{@vipItemName}" from {_p}

function pofGiveLeaveItem(p: player):
    if {_p} is not set:
        stop
    set slot 0 of {_p} to air
    remove {@lobbyItem} named "{@lobbyItemName}" from {_p}
    set slot 8 of {_p} to {@leaveItem} named "{@leaveItemName}"
    if {_p} has permission "pof.vip":
        set slot 4 of {_p} to {@vipItem} named "{@vipItemName}"
    else:
        set slot 4 of {_p} to air
        remove {@vipItem} named "{@vipItemName}" from {_p}

