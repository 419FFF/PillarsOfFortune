function pofBlockAmount() :: number:
    set {_r} to random integer between 1 and 100
    if {_r} <= 8:
        return 4
    if {_r} <= 18:
        return 5
    if {_r} <= 30:
        return 6
    if {_r} <= 44:
        return 7
    if {_r} <= 58:
        return 8
    if {_r} <= 72:
        return 9
    if {_r} <= 84:
        return 10
    if {_r} <= 93:
        return 11
    return 12

function pofGiveRandom(p: player):
    if {_p} is not set:
        stop
    set {_u} to UUID of {_p}
    if {pof.player.alive::%{_u}%} is not true:
        stop
    set {_r} to random integer between 1 and 100
    set {_w1} to {@rateWeapons}
    set {_w2} to {_w1} + {@rateArmor}
    set {_w3} to {_w2} + {@rateBlocks}
    if {_r} <= {_w1}:
        set {_pool} to "weapons"
    else if {_r} <= {_w2}:
        set {_pool} to "armor"
    else if {_r} <= {_w3}:
        set {_pool} to "blocks"
    else:
        set {_pool} to "chaos"
    set {_i} to a random element out of {pof.items.blocks::*}
    if {_pool} is "weapons":
        if {pof.items.weapons::*} is set:
            set {_i} to a random element out of {pof.items.weapons::*}
    else if {_pool} is "armor":
        if {pof.items.armor::*} is set:
            set {_i} to a random element out of {pof.items.armor::*}
    else if {_pool} is "blocks":
        if {pof.items.blocks::*} is set:
            set {_i} to a random element out of {pof.items.blocks::*}
    else if {_pool} is "chaos":
        if {pof.items.chaos::*} is set:
            set {_i} to a random element out of {pof.items.chaos::*}
    if {_i} is not set:
        stop
    if pofIsIllegal({_i}) is true:
        stop
    set {_amt} to 1
    set {_iname} to "%{_i}%"
    if {_pool} is "blocks":
        set {_amt} to pofBlockAmount()
    if {_iname} contains "obsidian":
        set {_amt} to random integer between 1 and 2
    if {_iname} contains "arrow":
        set {_amt} to random integer between 1 and 2
    if {_iname} contains "snowball":
        set {_amt} to random integer between 1 and 2
    if {_iname} contains "tnt":
        set {_amt} to 1
    if {_iname} contains "ender pearl":
        if chance of {@pearlChance}%:
            set {_amt} to 1
        else:
            stop
    if {_iname} contains " of ":
        if chance of 12%:
            set {_keep} to 1
        else:
            if {_pool} is "chaos":
                set {_i} to cobble
                set {_iname} to "cobble"
                set {_amt} to pofBlockAmount()
            else if {_pool} is "weapons":
                set {_i} to wooden sword
                set {_iname} to "wooden sword"
                set {_amt} to 1
            else:
                set {_i} to leather helmet
                set {_iname} to "leather helmet"
                set {_amt} to 1
    give {_amt} of {_i} to {_p}
    if {_iname} contains "fishing rod":
        loop all items in {_p}'s inventory:
            if loop-item is fishing rod:
                set durability of loop-item to 64
    pofAddStat({_u}, "items", 1)
    pofStripIllegal({_p})

function pofClearArena(id: number):
    set {_w} to pofWorld(0)
    if {_w} is not set:
        stop
    set {_cx} to pofArenaX({_id})
    set {_cz} to pofArenaZ({_id})
    set {_r} to {@clearRadius}
    set {_x} to {_cx} - {_r}
    loop 10 times:
        set {_z} to {_cz} - {_r}
        loop 10 times:
            set {_x2} to {_x} + 15
            set {_z2} to {_z} + 15
            execute console command "minecraft:fill %{_x}% 1 %{_z}% %{_x2}% 60 %{_z2}% air"
            execute console command "minecraft:fill %{_x}% 61 %{_z}% %{_x2}% 120 %{_z2}% air"
            set {_z} to {_z} + 16
        set {_x} to {_x} + 16
    pofClearEntities({_id})

function pofClearEntities(id: number):
    set {_center} to pofCenter({_id})
    if {_center} is not set:
        stop
    loop all entities in radius 130 around {_center}:
        if loop-entity is a player:
            set {_skip} to 1
        else:
            kill loop-entity

function pofBuildArena(id: number):
    set {_w} to pofWorld(0)
    if {_w} is not set:
        stop
    set {_cx} to pofArenaX({_id})
    set {_cz} to pofArenaZ({_id})
    set {_top} to {@pillarY}
    set {_bot} to {@pillarY} - {@pillarHeight} + 1
    if {_bot} < 1:
        set {_bot} to 1
    set {pof.tmp.ox::1} to 20
    set {pof.tmp.oz::1} to 0
    set {pof.tmp.ox::2} to 17
    set {pof.tmp.oz::2} to 10
    set {pof.tmp.ox::3} to 10
    set {pof.tmp.oz::3} to 17
    set {pof.tmp.ox::4} to 0
    set {pof.tmp.oz::4} to 20
    set {pof.tmp.ox::5} to -10
    set {pof.tmp.oz::5} to 17
    set {pof.tmp.ox::6} to -17
    set {pof.tmp.oz::6} to 10
    set {pof.tmp.ox::7} to -20
    set {pof.tmp.oz::7} to 0
    set {pof.tmp.ox::8} to -17
    set {pof.tmp.oz::8} to -10
    set {pof.tmp.ox::9} to -10
    set {pof.tmp.oz::9} to -17
    set {pof.tmp.ox::10} to 0
    set {pof.tmp.oz::10} to -20
    set {pof.tmp.ox::11} to 10
    set {pof.tmp.oz::11} to -17
    set {pof.tmp.ox::12} to 17
    set {pof.tmp.oz::12} to -10
    loop integers from 1 to {@pillars}:
        set {_n} to loop-number
        set {_ox} to {pof.tmp.ox::%{_n}%}
        set {_oz} to {pof.tmp.oz::%{_n}%}
        if {_ox} is not set:
            set {_ox} to 0
        if {_oz} is not set:
            set {_oz} to 0
        set {_x} to {_cx} + {_ox}
        set {_z} to {_cz} + {_oz}
        loop integers from {_bot} to {_top}:
            set block at location({_x}, loop-number-2, {_z}, {_w}) to bedrock
        set {pof.arena.%{_id}%.pillar.%{_n}%} to location({_x}, {_top}, {_z}, {_w})
    delete {pof.tmp.ox::*}
    delete {pof.tmp.oz::*}

function pofSetCage(id: number, n: number, on: boolean):
    set {_loc} to {pof.arena.%{_id}%.pillar.%{_n}%}
    if {_loc} is not set:
        stop
    set {_w} to world of {_loc}
    set {_x} to x-coordinate of {_loc}
    set {_y} to y-coordinate of {_loc}
    set {_z} to z-coordinate of {_loc}
    if {_on} is true:
        set {_m} to glass
    else:
        set {_m} to air
    loop integers from -1 to 1:
        set {_dx} to loop-number
        loop integers from -1 to 1:
            set {_dz} to loop-number-2
            loop integers from 1 to 4:
                set {_dy} to loop-number-3
                set {_skip} to false
                if {_on} is true:
                    if {_dx} is 0:
                        if {_dz} is 0:
                            if {_dy} is 1:
                                set {_skip} to true
                            else if {_dy} is 2:
                                set {_skip} to true
                            else if {_dy} is 3:
                                set {_skip} to true
                if {_skip} is false:
                    set block at location({_x} + {_dx}, {_y} + {_dy}, {_z} + {_dz}, {_w}) to {_m}

function pofFreeArena(n: number) :: number:
    loop integers from 1 to {@arenas}:
        set {_s} to {pof.arena.%loop-number%.state}
        if {_s} is not set:
            return loop-number
        if {_s} is "WAITING":
            return loop-number

function pofAliveCount(id: number) :: number:
    set {_c} to size of {pof.arena.%{_id}%.alive::*}
    if {_c} is not set:
        set {_c} to 0
    return {_c}

function pofResetArenaState(id: number):
    delete {pof.arena.%{_id}%.players::*}
    delete {pof.arena.%{_id}%.alive::*}
    set {pof.arena.%{_id}%.state} to "WAITING"
    set {pof.arena.%{_id}%.count} to 0
    set {pof.arena.%{_id}%.item} to 0
    set {pof.arena.%{_id}%.grace} to 0
    set {pof.arena.%{_id}%.time} to 0
    set {pof.arena.%{_id}%.end} to 0
    delete {pof.arena.%{_id}%.winner}

function pofToLobby(p: player):
    if {_p} is not set:
        stop
    set {_u} to UUID of {_p}
    set {_id} to {pof.player.arena::%{_u}%}
    if {_id} is set:
        remove {_u} from {pof.arena.%{_id}%.players::*}
        remove {_u} from {pof.arena.%{_id}%.alive::*}
    delete {pof.player.arena::%{_u}%}
    delete {pof.player.alive::%{_u}%}
    delete {pof.player.kills::%{_u}%}
    delete {pof.player.pillar::%{_u}%}
    delete {pof.board.%{_u}%}
    set gamemode of {_p} to {@lobbyGamemode}
    clear {_p}'s inventory
    heal {_p}
    set food level of {_p} to 20
    set level of {_p} to 0
    execute console command "effect %name of {_p}% clear"
    if {pof.lobby} is set:
        teleport {_p} to {pof.lobby}
    else:
        set {_w} to pofWorld(0)
        if {_w} is set:
            teleport {_p} to spawn of {_w}
    pofGiveLobbyItem({_p})

function pofJoin(p: player):
    if {_p} is not set:
        stop
    pofEnsureStats({_p})
    set {_u} to UUID of {_p}
    if {pof.player.arena::%{_u}%} is set:
        pofMsg({_p}, "&cYou are already in a match.")
        stop
    if {pof.queue::*} contains {_u}:
        pofMsg({_p}, "&7Already in the queue.")
        stop
    add {_u} to {pof.queue::*}
    set {_n} to size of {pof.queue::*}
    pofMsg({_p}, "&eQueued. &7Players waiting: &f%{_n}%&7/&f{@maxPlayers}")
    pofSound({_p}, "random.orb", 1.2)
    pofGiveLeaveItem({_p})
    pofLobbyMsg("&e%{_p}% &7joined the queue &8(&f%{_n}%&7/&f{@maxPlayers}&8)")

function pofVipStart(p: player):
    if {_p} is not set:
        stop
    if {_p} does not have permission "pof.vip":
        if {_p} does not have permission "pof.admin":
            pofMsg({_p}, "&cNo permission.")
            stop
    set {_su} to UUID of {_p}
    if {pof.player.arena::%{_su}%} is set:
        pofMsg({_p}, "&cYou cannot use that during a match.")
        stop
    if {pof.queue::*} does not contain {_su}:
        pofMsg({_p}, "&cJoin the queue first.")
        stop
    set {_q} to size of {pof.queue::*}
    if {_q} is not set:
        set {_q} to 0
    if {_q} < {@minPlayers}:
        pofMsg({_p}, "&cNeed at least {@minPlayers} players in queue.")
        stop
    if {pof.queue.timer} is not set:
        set {pof.queue.timer} to {@queueSeconds}
    if {pof.queue.timer} > 5:
        set {pof.queue.timer} to 5
        loop {pof.queue::*}:
            set {_t} to pofPlayer(loop-value)
            if {_t} is set:
                pofMsg({_t}, "&eCountdown skipped to &f5&e seconds!")
                send {_t} title "&e5" with subtitle "&7Match starting" for 1 second
        pofMsg({_p}, "&aQueue timer set to 5 seconds.")
    else:
        pofMsg({_p}, "&7Timer already at &f%{pof.queue.timer}%&7s.")

function pofBoard(p: player):
    if {_p} is not set:
        stop
    set {_u} to UUID of {_p}
    set {_wins} to pofStat({_u}, "wins")
    set {_kills} to pofStat({_u}, "kills")
    set {_streak} to pofStat({_u}, "streak")
    set {_q} to size of {pof.queue::*}
    if {_q} is not set:
        set {_q} to 0
    set {_id} to {pof.player.arena::%{_u}%}
    set {_mode} to "lobby"
    if {_id} is set:
        set {_state} to {pof.arena.%{_id}%.state}
        if {_state} is "STARTING":
            set {_mode} to "starting"
        else if {_state} is "ENDING":
            set {_mode} to "ending"
        else if {_state} is "INGAME":
            set {_gr} to {pof.arena.%{_id}%.grace}
            if {_gr} is set:
                if {_gr} > 0:
                    set {_mode} to "grace"
                else:
                    set {_mode} to "ingame"
            else:
                set {_mode} to "ingame"
    if {pof.queue::*} contains {_u}:
        if {_mode} is "lobby":
            set {_mode} to "queued"
    if {pof.board.%{_u}%} is not {_mode}:
        wipe {_p}'s sidebar
        set {pof.board.%{_u}%} to {_mode}
        set name of sidebar of {_p} to "&6&lPILLARS"
        if {_mode} is "starting":
            set name of sidebar of {_p} to "&6&lSTARTING"
        else if {_mode} is "ending":
            set name of sidebar of {_p} to "&6&lFINISHED"
        else if {_mode} is "ingame":
            set name of sidebar of {_p} to "&6&lFORTUNE"
        else if {_mode} is "grace":
            set name of sidebar of {_p} to "&6&lFORTUNE"
        set id based score "&8" in sidebar of {_p} to 2 with id "pof.%{_u}%.pad"
        set id based score "&e{@serverIP}" in sidebar of {_p} to 1 with id "pof.%{_u}%.ip"
        if {_mode} is "lobby":
            set id based score "&6/pof join" in sidebar of {_p} to 11 with id "pof.%{_u}%.a"
            set id based score "&fWins: &e%{_wins}%" in sidebar of {_p} to 10 with id "pof.%{_u}%.b"
            set id based score "&fKills: &e%{_kills}%" in sidebar of {_p} to 9 with id "pof.%{_u}%.c"
            set id based score "&fStreak: &e%{_streak}%" in sidebar of {_p} to 8 with id "pof.%{_u}%.d"
        else if {_mode} is "queued":
            set {_qt} to 0
            if {pof.queue.timer} is set:
                set {_qt} to {pof.queue.timer}
            set id based score "&fStart: &e%{_qt}%s" in sidebar of {_p} to 11 with id "pof.%{_u}%.a"
            set id based score "&fQueue: &e%{_q}%&7/&f{@maxPlayers}" in sidebar of {_p} to 10 with id "pof.%{_u}%.b"
        else if {_mode} is "starting":
            set {_alive} to pofAliveCount({_id})
            set {_cd} to {pof.arena.%{_id}%.count}
            set id based score "&fArena: &e%{_id}%" in sidebar of {_p} to 11 with id "pof.%{_u}%.a"
            set id based score "&fStarts: &e%{_cd}%s" in sidebar of {_p} to 10 with id "pof.%{_u}%.b"
            set id based score "&fAlive: &e%{_alive}%" in sidebar of {_p} to 9 with id "pof.%{_u}%.c"
        else if {_mode} is "ending":
            set {_gk} to {pof.player.kills::%{_u}%}
            if {_gk} is not set:
                set {_gk} to 0
            set {_alive} to pofAliveCount({_id})
            set id based score "&fArena: &e%{_id}%" in sidebar of {_p} to 11 with id "pof.%{_u}%.a"
            set id based score "&fAlive: &e%{_alive}%" in sidebar of {_p} to 10 with id "pof.%{_u}%.b"
            set id based score "&fKills: &e%{_gk}%" in sidebar of {_p} to 9 with id "pof.%{_u}%.c"
        else:
            set {_gk} to {pof.player.kills::%{_u}%}
            if {_gk} is not set:
                set {_gk} to 0
            set {_next} to {pof.arena.%{_id}%.item}
            set {_t} to {pof.arena.%{_id}%.time}
            set {_alive} to pofAliveCount({_id})
            set id based score "&fArena: &e%{_id}%" in sidebar of {_p} to 12 with id "pof.%{_u}%.a"
            set id based score "&fAlive: &e%{_alive}%" in sidebar of {_p} to 11 with id "pof.%{_u}%.b"
            set id based score "&fKills: &e%{_gk}%" in sidebar of {_p} to 10 with id "pof.%{_u}%.c"
            set id based score "&fItem: &e%{_next}%s" in sidebar of {_p} to 9 with id "pof.%{_u}%.d"
            set id based score "&fTime: &e%{_t}%s" in sidebar of {_p} to 8 with id "pof.%{_u}%.e"
            if {_mode} is "grace":
                set id based score "&aGrace: &f%{pof.arena.%{_id}%.grace}%s" in sidebar of {_p} to 7 with id "pof.%{_u}%.f"
        stop
    if {_mode} is "lobby":
        update score with id "pof.%{_u}%.b" to "&fWins: &e%{_wins}%" and 10
        update score with id "pof.%{_u}%.c" to "&fKills: &e%{_kills}%" and 9
        update score with id "pof.%{_u}%.d" to "&fStreak: &e%{_streak}%" and 8
        stop
    if {_mode} is "queued":
        set {_qt} to 0
        if {pof.queue.timer} is set:
            set {_qt} to {pof.queue.timer}
        update score with id "pof.%{_u}%.a" to "&fStart: &e%{_qt}%s" and 11
        update score with id "pof.%{_u}%.b" to "&fQueue: &e%{_q}%&7/&f{@maxPlayers}" and 10
        stop
    if {_mode} is "starting":
        set {_alive} to pofAliveCount({_id})
        set {_cd} to {pof.arena.%{_id}%.count}
        update score with id "pof.%{_u}%.b" to "&fStarts: &e%{_cd}%s" and 10
        update score with id "pof.%{_u}%.c" to "&fAlive: &e%{_alive}%" and 9
        stop
    if {_mode} is "ending":
        set {_gk} to {pof.player.kills::%{_u}%}
        if {_gk} is not set:
            set {_gk} to 0
        set {_alive} to pofAliveCount({_id})
        update score with id "pof.%{_u}%.b" to "&fAlive: &e%{_alive}%" and 10
        update score with id "pof.%{_u}%.c" to "&fKills: &e%{_gk}%" and 9
        stop
    set {_gk} to {pof.player.kills::%{_u}%}
    if {_gk} is not set:
        set {_gk} to 0
    set {_next} to {pof.arena.%{_id}%.item}
    set {_t} to {pof.arena.%{_id}%.time}
    set {_alive} to pofAliveCount({_id})
    update score with id "pof.%{_u}%.b" to "&fAlive: &e%{_alive}%" and 11
    update score with id "pof.%{_u}%.c" to "&fKills: &e%{_gk}%" and 10
    update score with id "pof.%{_u}%.d" to "&fItem: &e%{_next}%s" and 9
    update score with id "pof.%{_u}%.e" to "&fTime: &e%{_t}%s" and 8
    if {_mode} is "grace":
        update score with id "pof.%{_u}%.f" to "&aGrace: &f%{pof.arena.%{_id}%.grace}%s" and 7

function pofTab(p: player):
    if {_p} is not set:
        stop
    set {_u} to UUID of {_p}
    set {_id} to {pof.player.arena::%{_u}%}
    set {_q} to size of {pof.queue::*}
    if {_q} is not set:
        set {_q} to 0
    set {_online} to number of all players
    if {_id} is not set:
        set tab header to "&6&lPILLARS OF FORTUNE" and footer to "&7Queue &f%{_q}% &8| &7Online &f%{_online}% &8| &e{@serverIP}" for {_p}
        if {pof.queue::*} contains {_u}:
            set {_p} tab name to "&e%{_p}%"
        else:
            set {_p} tab name to "&7%{_p}%"
        stop
    set {_alive} to pofAliveCount({_id})
    set {_state} to {pof.arena.%{_id}%.state}
    set tab header to "&6&lPILLARS OF FORTUNE &8- &7Arena %{_id}%" and footer to "&f%{_state}% &8| &e%{_alive}% alive &8| &e{@serverIP}" for {_p}
    if {pof.player.alive::%{_u}%} is true:
        set {_p} tab name to "&a%{_p}%"
    else:
        set {_p} tab name to "&8%{_p}%"

function pofCheckWin(id: number):
    if {pof.arena.%{_id}%.state} is not "INGAME":
        stop
    set {_n} to pofAliveCount({_id})
    if {_n} <= 0:
        pofFinish({_id}, "none")
    else if {_n} is 1:
        loop {pof.arena.%{_id}%.alive::*}:
            pofFinish({_id}, loop-value)

function pofEliminate(p: player, reason: text):
    if {_p} is not set:
        stop
    set {_u} to UUID of {_p}
    if {pof.player.alive::%{_u}%} is not true:
        stop
    set {_id} to {pof.player.arena::%{_u}%}
    if {_id} is not set:
        stop
    set {pof.player.alive::%{_u}%} to false
    remove {_u} from {pof.arena.%{_id}%.alive::*}
    pofAddStat({_u}, "deaths", 1)
    set {pof.stat.%{_u}%.streak} to 0
    clear {_p}'s inventory
    set gamemode of {_p} to spectator
    set {_center} to pofCenter({_id})
    if {_center} is set:
        teleport {_p} to {_center}
    if {_reason} is "void":
        pofAMsg({_id}, "&e%{_p}% &7fell into the void.")
    else if {_reason} is "leave":
        pofAMsg({_id}, "&e%{_p}% &7forfeited.")
    else:
        pofAMsg({_id}, "&e%{_p}% &7was eliminated.")
    send {_p} title "&cELIMINATED" with subtitle "&7You are spectating" for 3 seconds
    play sound "mob.wither.hurt" with volume 0.25 and pitch 1.3 at {_p} for {_p}
    pofCheckWin({_id})

function pofFinish(id: number, winner: text):
    if {pof.arena.%{_id}%.state} is "ENDING":
        stop
    set {pof.arena.%{_id}%.state} to "ENDING"
    set {pof.arena.%{_id}%.end} to {@endSeconds}
    set {pof.arena.%{_id}%.winner} to {_winner}
    if {_winner} is "none":
        pofAMsg({_id}, "&cNo winner. The pillars are empty.")
        loop {pof.arena.%{_id}%.players::*}:
            set {_p} to pofPlayer(loop-value)
            if {_p} is set:
                send {_p} title "&7DRAW" with subtitle "&8No one remained" for 4 seconds
        stop
    set {_wp} to pofPlayer({_winner})
    pofAddStat({_winner}, "wins", 1)
    set {_st} to pofStat({_winner}, "streak") + 1
    set {pof.stat.%{_winner}%.streak} to {_st}
    set {_best} to pofStat({_winner}, "beststreak")
    if {_st} > {_best}:
        set {pof.stat.%{_winner}%.beststreak} to {_st}
    set {_wname} to {pof.stat.%{_winner}%.name}
    if {_wp} is set:
        set {_wname} to "%{_wp}%"
        send {_wp} title "&6&lVICTORY" with subtitle "&eYou own the pillars" for 5 seconds
        pofSound({_wp}, "random.levelup", 1)
        set {_wp} tab name to "&6%{_wp}%"
    pofAMsg({_id}, "&6%{_wname}% &ewon Pillars of Fortune!")
    loop {pof.arena.%{_id}%.players::*}:
        set {_p} to pofPlayer(loop-value)
        if {_p} is set:
            if UUID of {_p} is not {_winner}:
                send {_p} title "&cDEFEAT" with subtitle "&7Winner: &e%{_wname}%" for 4 seconds
                pofSound({_p}, "random.explode", 1.4)

function pofBeginStart(id: number):
    set {pof.arena.%{_id}%.state} to "STARTING"
    set {pof.arena.%{_id}%.count} to {@countdown}
    pofClearArena({_id})
    pofBuildArena({_id})
    set {_n} to 1
    loop {pof.arena.%{_id}%.players::*}:
        set {_u} to loop-value
        set {_p} to pofPlayer({_u})
        set {pof.player.arena::%{_u}%} to {_id}
        set {pof.player.alive::%{_u}%} to true
        set {pof.player.kills::%{_u}%} to 0
        set {pof.player.pillar::%{_u}%} to {_n}
        delete {pof.board.%{_u}%}
        pofAddStat({_u}, "games", 1)
        if {_p} is set:
            set {_loc} to {pof.arena.%{_id}%.pillar.%{_n}%}
            if {_loc} is set:
                set {_w} to world of {_loc}
                set {_x} to x-coordinate of {_loc} + 0.5
                set {_y} to y-coordinate of {_loc} + 1
                set {_z} to z-coordinate of {_loc} + 0.5
                teleport {_p} to location({_x}, {_y}, {_z}, {_w})
            pofSetCage({_id}, {_n}, true)
            set gamemode of {_p} to adventure
            clear {_p}'s inventory
            heal {_p}
            set food level of {_p} to 20
            execute console command "effect %name of {_p}% clear"
            send {_p} title "&6&lPILLARS OF FORTUNE" with subtitle "&eCages open in {@countdown}s" for 3 seconds
            pofSound({_p}, "mob.wither.spawn", 1.5)
        add 1 to {_n}

function pofBeginPlay(id: number):
    pofClearEntities({_id})
    set {pof.arena.%{_id}%.state} to "INGAME"
    set {pof.arena.%{_id}%.item} to {@itemSeconds}
    set {pof.arena.%{_id}%.grace} to {@graceSeconds}
    set {pof.arena.%{_id}%.time} to 0
    loop integers from 1 to {@pillars}:
        pofSetCage({_id}, loop-number, false)
    loop {pof.arena.%{_id}%.alive::*}:
        set {_p} to pofPlayer(loop-value)
        if {_p} is set:
            set gamemode of {_p} to survival
            send {_p} title "&6FIGHT" with subtitle "&7Items incoming" for 2 seconds
            pofSound({_p}, "random.levelup", 0.8)
            pofGiveRandom({_p})

function pofTryStart(n: number):
    set {_q} to size of {pof.queue::*}
    if {_q} is not set:
        set {_q} to 0
    if {_q} < {@minPlayers}:
        delete {pof.queue.timer}
        stop
    if {pof.queue.timer} is not set:
        set {pof.queue.timer} to {@queueSeconds}
        loop {pof.queue::*}:
            set {_p} to pofPlayer(loop-value)
            if {_p} is set:
                pofMsg({_p}, "&eMatch starting in &f{@queueSeconds}&e seconds.")
        stop
    subtract 1 from {pof.queue.timer}
    set {_t} to {pof.queue.timer}
    if {_t} <= 0:
        set {_arena} to pofFreeArena(0)
        if {_arena} is not set:
            set {pof.queue.timer} to 5
            stop
        delete {pof.batch::*}
        set {_taken} to 0
        loop {pof.queue::*}:
            if {_taken} < {@maxPlayers}:
                add loop-value to {pof.batch::*}
                add 1 to {_taken}
        loop {pof.batch::*}:
            remove loop-value from {pof.queue::*}
            add loop-value to {pof.arena.%{_arena}%.players::*}
            add loop-value to {pof.arena.%{_arena}%.alive::*}
        delete {pof.queue.timer}
        pofBeginStart({_arena})
        stop
    if {_t} <= 5:
        loop {pof.queue::*}:
            set {_p} to pofPlayer(loop-value)
            if {_p} is set:
                send {_p} title "&e%{_t}%" with subtitle "&7Match starting" for 1 second
                pofSound({_p}, "note.pling", 1)
    else if {_t} is 20:
        pofLobbyMsg("&eMatch starting in &f20&e seconds...")
    else if {_t} is 10:
        pofLobbyMsg("&eMatch starting in &f10&e seconds...")

function pofTickArena(id: number):
    set {_s} to {pof.arena.%{_id}%.state}
    if {_s} is not set:
        set {pof.arena.%{_id}%.state} to "WAITING"
        stop
    if {_s} is "STARTING":
        subtract 1 from {pof.arena.%{_id}%.count}
        set {_c} to {pof.arena.%{_id}%.count}
        loop {pof.arena.%{_id}%.players::*}:
            set {_p} to pofPlayer(loop-value)
            if {_p} is set:
                if {_c} <= 5:
                    if {_c} > 0:
                        send {_p} title "&6%{_c}%" with subtitle "&7Get ready" for 1 second
                        pofSound({_p}, "note.pling", 1)
        if {_c} <= 0:
            pofBeginPlay({_id})
        stop
    if {_s} is "INGAME":
        add 1 to {pof.arena.%{_id}%.time}
        if {pof.arena.%{_id}%.grace} > 0:
            subtract 1 from {pof.arena.%{_id}%.grace}
            if {pof.arena.%{_id}%.grace} is 0:
                pofAMsg({_id}, "&cGrace period over. PvP is live.")
        subtract 1 from {pof.arena.%{_id}%.item}
        if {pof.arena.%{_id}%.item} <= 0:
            set {_interval} to {@itemSeconds}
            if {pof.arena.%{_id}%.time} >= {@maxGameSeconds}:
                set {_interval} to 2
            set {pof.arena.%{_id}%.item} to {_interval}
            loop {pof.arena.%{_id}%.alive::*}:
                set {_p} to pofPlayer(loop-value)
                if {_p} is set:
                    pofGiveRandom({_p})
                    pofSound({_p}, "random.pop", 1.3)
                    set action bar of {_p} to "&6+ item"
            if {pof.arena.%{_id}%.time} >= {@maxGameSeconds}:
                if mod({pof.arena.%{_id}%.time}, 10) is 0:
                    pofAMsg({_id}, "&cSudden death! Lightning on the pillars.")
                    loop integers from 1 to {@pillars}:
                        if chance of 35%:
                            set {_pl} to {pof.arena.%{_id}%.pillar.%loop-number%}
                            if {_pl} is set:
                                strike lightning at {_pl}
        pofCheckWin({_id})
        stop
    if {_s} is "ENDING":
        subtract 1 from {pof.arena.%{_id}%.end}
        if {pof.arena.%{_id}%.end} <= 0:
            loop {pof.arena.%{_id}%.players::*}:
                set {_p} to pofPlayer(loop-value)
                if {_p} is set:
                    pofToLobby({_p})
            pofClearArena({_id})
            pofBuildArena({_id})
            pofResetArenaState({_id})

# ------------------------------------------------------------
# Load / unload
# ------------------------------------------------------------

on load:
    pofInitPools(0)
    set {_w} to pofWorld(0)
    if {_w} is not set:
        send "[PoF] World '{@world}' was not found. Edit options: world:" to console
    if {pof.lobby} is not set:
        if {_w} is set:
            set {pof.lobby} to spawn of {_w}
    delete {pof.queue::*}
    delete {pof.queue.timer}
    loop integers from 1 to {@arenas}:
        pofResetArenaState(loop-number)
        pofClearArena(loop-number)
        pofBuildArena(loop-number)
    loop all players:
        pofEnsureStats(loop-player)
        pofToLobby(loop-player)
        pofBoard(loop-player)
        pofTab(loop-player)
    execute console command "weather clear 1000000"
    set {_w} to pofWorld(0)
    if {_w} is set:
        set weather of {_w} to clear
    send "[PoF] Pillars of Fortune loaded. Arenas: {@arenas}." to console

on unload:
    loop all players:
        wipe loop-player's sidebar

on join:
    wait 5 ticks
    pofEnsureStats(player)
    pofToLobby(player)
    pofBoard(player)
    pofTab(player)
    pofMsg(player, "&7Right-click the &equeue item &7or type &e/pof join&7.")
    set join message to "{@prefix} &e%player% &7joined."

on quit:
    set {_u} to UUID of player
    set {_id} to {pof.player.arena::%{_u}%}
    if {pof.player.alive::%{_u}%} is true:
        pofEliminate(player, "leave")
    remove {_u} from {pof.queue::*}
    if {_id} is set:
        remove {_u} from {pof.arena.%{_id}%.players::*}
        remove {_u} from {pof.arena.%{_id}%.alive::*}
        pofCheckWin({_id})
    set quit message to "{@prefix} &e%player% &7left."

# ------------------------------------------------------------
# Commands
# ------------------------------------------------------------

command /pof [<text>] [<text>]:
    aliases: /pillars, /fortune
    description: Pillars of Fortune
    usage: /pof [join|leave|stats|top|start|stop|setlobby|regen|arenas]
    executable by: players and console
    trigger:
        if arg-1 is not set:
            if player is set:
                pofMsg(player, "&6/pof join&7, &6leave&7, &6stats&7, &6top")
                if player has permission "pof.admin":
                    pofMsg(player, "&cAdmin: &6start stop setlobby regen arenas debug")
            else:
                send "[PoF] /pof stop | regen | arenas" to console
            stop
        if arg-1 is "join":
            if player is not set:
                stop
            pofJoin(player)
            stop
        if arg-1 is "debug":
            if player is set:
                if player does not have permission "pof.admin":
                    pofMsg(player, "&cNo permission.")
                    stop
            if {pof.debug} is true:
                set {pof.debug} to false
                if player is set:
                    pofMsg(player, "&7Debug &cOFF")
                stop
            set {pof.debug} to true
            if player is set:
                pofMsg(player, "&7Debug &aON")
            stop
        if arg-1 is "leave":
            if player is not set:
                stop
            set {_u} to UUID of player
            if {pof.player.alive::%{_u}%} is true:
                pofEliminate(player, "leave")
                pofToLobby(player)
                pofMsg(player, "&7You forfeited.")
                stop
            if {pof.queue::*} contains {_u}:
                remove {_u} from {pof.queue::*}
                remove {@leaveItem} named "{@leaveItemName}" from player
                set slot 8 of player to air
                pofGiveLobbyItem(player)
                pofMsg(player, "&7Left the queue.")
                set {_n} to size of {pof.queue::*}
                if {_n} is not set:
                    set {_n} to 0
                pofLobbyMsg("&e%player% &7left the queue &8(&f%{_n}%&7/&f{@maxPlayers}&8)")
                stop
            pofMsg(player, "&7Nothing to leave.")
            stop
        if arg-1 is "stats":
            if player is not set:
                stop
            set {_t} to player
            if arg-2 is set:
                set {_t} to arg-2 parsed as player
                if {_t} is not set:
                    pofMsg(player, "&cPlayer not online.")
                    stop
            pofEnsureStats({_t})
            set {_u} to UUID of {_t}
            set {_wins} to pofStat({_u}, "wins")
            set {_kills} to pofStat({_u}, "kills")
            set {_deaths} to pofStat({_u}, "deaths")
            set {_games} to pofStat({_u}, "games")
            set {_streak} to pofStat({_u}, "streak")
            set {_best} to pofStat({_u}, "beststreak")
            set {_items} to pofStat({_u}, "items")
            set {_mins} to pofStat({_u}, "playtime")
            pofMsg(player, "&6%{_t}% &7career stats")
            pofMsg(player, "&e%{_wins}% &7wins  &e%{_kills}% &7kills  &e%{_deaths}% &7deaths")
            pofMsg(player, "&e%{_games}% &7games  &e%{_streak}% &7streak  &e%{_best}% &7best")
            pofMsg(player, "&e%{_items}% &7items rolled  &e%{_mins}% &7min played")
            stop
        if arg-1 is "top":
            if player is not set:
                stop
            pofMsg(player, "&6Top wins")
            set {_mu} to UUID of player
            set {_mw} to {pof.stat.%{_mu}%.wins}
            set {_ow} to {pof.wins::%{_mu}%}
            set {_ps} to size of {pof.players::*}
            set {_os} to size of {pof.wins::*}
            if {_ps} is not set:
                set {_ps} to 0
            if {_os} is not set:
                set {_os} to 0
            if {pof.debug} is true:
                pofMsg(player, "&8debug you=%{_mu}%")
                pofMsg(player, "&8debug newWins=%{_mw}% oldWins=%{_ow}%")
                pofMsg(player, "&8debug playersList=%{_ps}% oldWinsList=%{_os}%")
            delete {_nlist::*}
            delete {_wlist::*}
            set {_cnt} to 0
            loop all players:
                pofEnsureStats(loop-player)
                set {_ou} to UUID of loop-player
                set {_ow2} to pofStat({_ou}, "wins")
                if {pof.debug} is true:
                    pofMsg(player, "&8debug online %loop-player% wins=%{_ow2}%")
                if {_ow2} is set:
                    if {_ow2} > 0:
                        add 1 to {_cnt}
                        set {_nlist::%{_cnt}%} to "%loop-player%"
                        set {_wlist::%{_cnt}%} to {_ow2}
            loop {pof.index::*}:
                set {_u} to loop-index
                set {_w} to pofStat({_u}, "wins")
                if {_w} is not set:
                    set {_w} to {pof.wins::%{_u}%}
                if {pof.debug} is true:
                    pofMsg(player, "&8debug listed %{_u}% wins=%{_w}%")
                if {_w} is set:
                    if {_w} > 0:
                        set {_name} to {pof.stat.%{_u}%.name}
                        if {_name} is not set:
                            set {_name} to "unknown"
                        set {_found} to false
                        set {_fi} to 0
                        set {_j} to 1
                        loop 64 times:
                            if {_j} <= {_cnt}:
                                set {_en} to {_nlist::%{_j}%}
                                if "%{_en}%" is "%{_name}%":
                                    set {_found} to true
                                    set {_fi} to {_j}
                            add 1 to {_j}
                        if {_found} is true:
                            set {_ew} to {_wlist::%{_fi}%}
                            if {_w} > {_ew}:
                                set {_wlist::%{_fi}%} to {_w}
                        else:
                            add 1 to {_cnt}
                            set {_nlist::%{_cnt}%} to {_name}
                            set {_wlist::%{_cnt}%} to {_w}
            loop {pof.wins::*}:
                set {_w} to loop-value
                set {_u} to loop-index
                if {_w} is set:
                    if {_w} > 0:
                        set {_name} to {pof.stat.%{_u}%.name}
                        if {_name} is not set:
                            set {_name} to {pof.name::%{_u}%}
                        if {_name} is not set:
                            set {_name} to "%{_u}%"
                        set {_found} to false
                        set {_j} to 1
                        loop 64 times:
                            if {_j} <= {_cnt}:
                                set {_en} to {_nlist::%{_j}%}
                                if "%{_en}%" is "%{_name}%":
                                    set {_found} to true
                                    set {_fi} to {_j}
                            add 1 to {_j}
                        if {_found} is true:
                            set {_ew} to {_wlist::%{_fi}%}
                            if {_w} > {_ew}:
                                set {_wlist::%{_fi}%} to {_w}
                        else:
                            add 1 to {_cnt}
                            set {_nlist::%{_cnt}%} to {_name}
                            set {_wlist::%{_cnt}%} to {_w}
            set {_shown} to 0
            loop 10 times:
                set {_besti} to 0
                set {_bestw} to 0
                set {_i} to 1
                loop 64 times:
                    if {_i} <= {_cnt}:
                        set {_nw} to {_wlist::%{_i}%}
                        if {_nw} is set:
                            if {_nw} > {_bestw}:
                                set {_bestw} to {_nw}
                                set {_besti} to {_i}
                    add 1 to {_i}
                if {_bestw} > 0:
                    add 1 to {_shown}
                    set {_bestn} to {_nlist::%{_besti}%}
                    pofMsg(player, "&e%{_shown}%. &f%{_bestn}% &7- &6%{_bestw}% &7wins")
                    set {_wlist::%{_besti}%} to -1
            if {pof.debug} is true:
                pofMsg(player, "&8debug builtEntries=%{_cnt}% shown=%{_shown}%")
            if {_shown} is 0:
                pofMsg(player, "&7No games recorded yet.")
            stop
        if player is set:
            if player does not have permission "pof.admin":
                if arg-1 is "start":
                    if player does not have permission "pof.vip":
                        pofMsg(player, "&cNo permission.")
                        stop
                if arg-1 is "stop":
                    pofMsg(player, "&cNo permission.")
                    stop
                if arg-1 is "setlobby":
                    pofMsg(player, "&cNo permission.")
                    stop
                if arg-1 is "regen":
                    pofMsg(player, "&cNo permission.")
                    stop
                if arg-1 is "arenas":
                    pofMsg(player, "&cNo permission.")
                    stop
        if arg-1 is "setlobby":
            if player is not set:
                stop
            set {pof.lobby} to location of player
            pofMsg(player, "&aLobby set.")
            stop
        if arg-1 is "start":
            if player is set:
                if player does not have permission "pof.vip":
                    if player does not have permission "pof.admin":
                        pofMsg(player, "&cNo permission.")
                        stop
                set {_su} to UUID of player
                if {pof.player.arena::%{_su}%} is set:
                    pofMsg(player, "&cYou cannot use that during a match.")
                    stop
                if {pof.queue::*} does not contain {_su}:
                    if player does not have permission "pof.admin":
                        pofMsg(player, "&cJoin the queue first.")
                        stop
            set {_q} to size of {pof.queue::*}
            if {_q} is not set:
                set {_q} to 0
            if {_q} < {@minPlayers}:
                if player is set:
                    pofMsg(player, "&cNeed at least {@minPlayers} players in queue.")
                stop
            if {pof.queue.timer} is not set:
                set {pof.queue.timer} to {@queueSeconds}
            if {pof.queue.timer} > 5:
                set {pof.queue.timer} to 5
                loop {pof.queue::*}:
                    set {_p} to pofPlayer(loop-value)
                    if {_p} is set:
                        pofMsg({_p}, "&eCountdown skipped to &f5&e seconds!")
                        send {_p} title "&e5" with subtitle "&7Match starting" for 1 second
                if player is set:
                    pofMsg(player, "&aQueue timer set to 5 seconds.")
            else:
                if player is set:
                    pofMsg(player, "&7Timer already at &f%{pof.queue.timer}%&7s.")
            stop
        if arg-1 is "stop":
            if arg-2 is set:
                set {_id} to arg-2 parsed as number
                if {_id} is set:
                    loop {pof.arena.%{_id}%.players::*}:
                        set {_p} to pofPlayer(loop-value)
                        if {_p} is set:
                            pofToLobby({_p})
                    pofResetArenaState({_id})
                    if player is set:
                        pofMsg(player, "&cStopped arena %{_id}%.")
                    stop
            loop integers from 1 to {@arenas}:
                loop {pof.arena.%loop-number%.players::*}:
                    set {_p} to pofPlayer(loop-value-2)
                    if {_p} is set:
                        pofToLobby({_p})
                pofResetArenaState(loop-number)
            delete {pof.queue::*}
            if player is set:
                pofMsg(player, "&cAll arenas stopped.")
            else:
                send "[PoF] All arenas stopped." to console
            stop
        if arg-1 is "regen":
            loop integers from 1 to {@arenas}:
                if {pof.arena.%loop-number%.state} is "WAITING":
                    pofClearArena(loop-number)
                    pofBuildArena(loop-number)
            if player is set:
                pofMsg(player, "&aIdle arenas rebuilt.")
            else:
                send "[PoF] Idle arenas rebuilt." to console
            stop
        if arg-1 is "arenas":
            loop integers from 1 to {@arenas}:
                set {_st} to {pof.arena.%loop-number%.state}
                set {_al} to pofAliveCount(loop-number)
                set {_line} to "&e##%loop-number% &7%{_st}% &8- &f%{_al}% alive"
                if player is set:
                    pofMsg(player, {_line})
                else:
                    send "[PoF] Arena %loop-number% %{_st}% (%{_al}% alive)" to console
            stop
        if player is set:
            pofMsg(player, "&cUnknown subcommand. &7/pof")

# ------------------------------------------------------------
# Game ticks
# ------------------------------------------------------------

every 1 second:
    pofTryStart(0)
    loop integers from 1 to {@arenas}:
        pofTickArena(loop-number)
    loop all players:
        pofBoard(loop-player)
        pofTab(loop-player)
        set {_u} to UUID of loop-player
        if {pof.player.alive::%{_u}%} is true:
            set {_id} to {pof.player.arena::%{_u}%}
            set {_st} to {pof.arena.%{_id}%.state}
            if {_st} is not "ENDING":
                if y-coordinate of loop-player < {@voidY}:
                    pofEliminate(loop-player, "void")
                else:
                    set {_c} to pofCenter({_id})
                    if {_c} is set:
                        if distance between loop-player and {_c} > {@borderKill}:
                            pofEliminate(loop-player, "void")

every 1 tick:
    loop {pof.fb.live::*}:
        set {_fb} to loop-value
        if {_fb} is not set:
            remove {_fb} from {pof.fb.live::*}
        else:
            push {_fb} in direction of {_fb} at speed {@fireballAccel}

every 5 ticks:
    loop all players:
        set {_u} to UUID of loop-player
        if {pof.player.alive::%{_u}%} is true:
            set {_id} to {pof.player.arena::%{_u}%}
            if {pof.arena.%{_id}%.state} is not "ENDING":
                if y-coordinate of loop-player < {@voidY}:
                    pofEliminate(loop-player, "void")

every 5 seconds:
    loop all players:
        pofStripIllegal(loop-player)

every 10 seconds:
    loop all players:
        set food level of loop-player to 20
    execute console command "weather clear 1000000"
    set {_w} to pofWorld(0)
    if {_w} is set:
        set weather of {_w} to clear

every 60 seconds:
    loop all players:
        pofAddStat(UUID of loop-player, "playtime", 1)

# ------------------------------------------------------------
# Combat / world rules
# ------------------------------------------------------------

on damage:
    victim is a fireball
    attacker is a player
    delete {pof.fb.owner::%victim%}

on projectile hit:
    projectile is a fireball
    remove projectile from {pof.fb.live::*}
    delete {pof.fb.fly::%projectile%}
    set {_loc} to location of projectile
    if {_loc} is not set:
        stop
    loop all players in radius {@fireballRadius} around {_loc}:
        set {_u} to UUID of loop-player
        if {pof.player.alive::%{_u}%} is true:
            pofBlastPush(loop-player, {_loc})
            if {_u} is {pof.fb.lastshooter}:
                if {@fireballDmgSelf} > 0:
                    damage loop-player by {@fireballDmgSelf}
            else:
                if {@fireballDmgEnemy} > 0:
                    damage loop-player by {@fireballDmgEnemy}

on damage:
    victim is a player
    attacker is a fireball
    set {_own} to {pof.fb.owner::%attacker%}
    if {_own} is set:
        if {_own} is UUID of victim:
            set damage to 0
            stop

on damage:
    victim is a player
    set {_cs} to "%damage cause%"
    if {_cs} contains "explosion":
        if {pof.fb.lastshooter} is set:
            set damage to 0
            stop

on damage:
    victim is a player
    set {_u} to UUID of victim
    if {pof.player.arena::%{_u}%} is not set:
        cancel event
        stop
    set {_id} to {pof.player.arena::%{_u}%}
    if {pof.arena.%{_id}%.state} is "STARTING":
        cancel event
        stop
    if {pof.arena.%{_id}%.state} is "ENDING":
        cancel event
        stop
    if {pof.player.alive::%{_u}%} is not true:
        cancel event
        stop
    if {pof.arena.%{_id}%.grace} is set:
        if {pof.arena.%{_id}%.grace} > 0:
            cancel event
            stop
    if attacker is a player:
        set {_au} to UUID of attacker
        if {pof.player.arena::%{_au}%} is not {_id}:
            cancel event
            stop
        if tool of attacker is fishing rod:
            remove fishing rod from attacker
    if {pof.player.alive::%{_u}%} is true:
        set {_hp} to health of victim
        set {_dmg} to damage
        if {_dmg} is set:
            if {_hp} - {_dmg} < 1:
                cancel event
                set {_att} to attacker
                if {_att} is a player:
                    if {_att} is not victim:
                        set {_au} to UUID of {_att}
                        pofAddStat({_au}, "kills", 1)
                        if {pof.player.kills::%{_au}%} is not set:
                            set {pof.player.kills::%{_au}%} to 0
                        add 1 to {pof.player.kills::%{_au}%}
                        pofAMsg({_id}, "&e%victim% &7was slain by &c%{_att}%")
                        pofSound({_att}, "random.orb", 1.4)
                pofEliminate(victim, "death")

on damage:
    attacker is a player
    victim is not a player
    if tool of attacker is fishing rod:
        remove fishing rod from attacker

on death of player:
    set {_u} to UUID of victim
    if {pof.player.alive::%{_u}%} is true:
        set {_att} to attacker
        set health of victim to 20
        if {_att} is a player:
            if {_att} is not victim:
                set {_au} to UUID of {_att}
                pofAddStat({_au}, "kills", 1)
                if {pof.player.kills::%{_au}%} is not set:
                    set {pof.player.kills::%{_au}%} to 0
                add 1 to {pof.player.kills::%{_au}%}
                pofAMsg({pof.player.arena::%{_u}%}, "&e%victim% &7was slain by &c%{_att}%")
                pofSound({_att}, "random.orb", 1.4)
        pofEliminate(victim, "death")

on respawn:
    wait 1 tick
    set {_u} to UUID of player
    if {pof.player.arena::%{_u}%} is set:
        if {pof.player.alive::%{_u}%} is not true:
            set gamemode of player to spectator
            set {_c} to pofCenter({pof.player.arena::%{_u}%})
            if {_c} is set:
                teleport player to {_c}
            stop
    pofToLobby(player)

on pickup:
    if pofIsIllegal(event-item) is true:
        cancel event

on drop:
    if pofIsIllegal(event-item) is true:
        cancel event
        stop
    set {_n} to name of event-item
    if {_n} is set:
        if {_n} contains "Join Queue":
            cancel event
            stop
        if {_n} contains "Leave Queue":
            cancel event
            stop
        if {_n} contains "Start Match":
            cancel event
            stop
    set {_u} to UUID of player
    if {pof.player.arena::%{_u}%} is not set:
        cancel event

on craft:
    if pofIsIllegal(event-item) is true:
        cancel event

on rightclick with fire charge:
    player is set
    set {_u} to UUID of player
    if {pof.player.alive::%{_u}%} is not true:
        stop
    if {pof.player.arena::%{_u}%} is not set:
        stop
    set {_id} to {pof.player.arena::%{_u}%}
    if {pof.arena.%{_id}%.state} is not "INGAME":
        stop
    cancel event
    if {pof.fb.cd::%{_u}%} is true:
        stop
    set {pof.fb.cd::%{_u}%} to true
    remove 1 of fire charge from player
    set {pof.fb.lastshooter} to UUID of player
    set {pof.fb.protect::%{_u}%} to true
    shoot a fireball from player at speed {@fireballSpeed}
    set {_fb} to last spawned entity
    if {_fb} is set:
        add {_fb} to {pof.fb.live::*}
        set {pof.fb.fly::%{_fb}%} to UUID of player
    pofSound(player, "mob.ghast.fireball", 1.2)
    wait {@fireballCooldown} seconds
    delete {pof.fb.cd::%{_u}%}
    delete {pof.fb.protect::%{_u}%}

on rightclick:
    player is set
    set {_n} to name of tool of player
    if {_n} is set:
        if {_n} contains "Join Queue":
            pofJoin(player)
            stop
        if {_n} contains "Start Match":
            pofVipStart(player)
            stop
        if {_n} contains "Leave Queue":
            set {_u} to UUID of player
            if {pof.player.arena::%{_u}%} is set:
                stop
            if {pof.queue::*} contains {_u}:
                remove {_u} from {pof.queue::*}
                remove {@leaveItem} named "{@leaveItemName}" from player
                set slot 8 of player to air
                pofGiveLobbyItem(player)
                pofMsg(player, "&7Left the queue.")
                set {_qn} to size of {pof.queue::*}
                if {_qn} is not set:
                    set {_qn} to 0
                pofLobbyMsg("&e%player% &7left the queue &8(&f%{_qn}%&7/&f{@maxPlayers}&8)")
            stop

on place:
    set {_u} to UUID of player
    if {pof.player.arena::%{_u}%} is not set:
        if player does not have permission "pof.admin":
            cancel event
        stop
    if {pof.player.alive::%{_u}%} is not true:
        cancel event
        stop
    set {_id} to {pof.player.arena::%{_u}%}
    if {pof.arena.%{_id}%.state} is not "INGAME":
        cancel event
        stop
    if pofIsIllegal(tool of player) is true:
        cancel event
        stop
    set {_held} to "%tool of player%"
    if {_held} contains "bedrock":
        cancel event
        stop
    if y-coordinate of player > {@maxBuildY}:
        cancel event
        stop
    set {_c} to pofCenter({_id})
    if {_c} is set:
        set {_dx} to x-coordinate of player - x-coordinate of {_c}
        if {_dx} < 0:
            set {_dx} to -1 * {_dx}
        set {_dz} to z-coordinate of player - z-coordinate of {_c}
        if {_dz} < 0:
            set {_dz} to -1 * {_dz}
        if {_dx} > {@buildRadius}:
            cancel event
            stop
        if {_dz} > {@buildRadius}:
            cancel event
            stop

on break:
    set {_u} to UUID of player
    if {pof.player.arena::%{_u}%} is not set:
        if player does not have permission "pof.admin":
            cancel event
        stop
    if {pof.player.alive::%{_u}%} is not true:
        cancel event
        stop
    if {pof.arena.%{pof.player.arena::%{_u}%}%.state} is not "INGAME":
        cancel event
        stop
    set {_bn} to "%event-block%"
    if {_bn} contains "bedrock":
        cancel event

on food level change:
    cancel event

on portal:
    set {_u} to UUID of player
    if {pof.player.arena::%{_u}%} is set:
        cancel event

on chat:
    set {_u} to UUID of player
    set {_id} to {pof.player.arena::%{_u}%}
    if {_id} is set:
        cancel event
        set {_msg} to message
        if {pof.player.alive::%{_u}%} is true:
            set {_line} to "&8[&6PoF&8] &f%player%&8: &7%{_msg}%"
        else:
            set {_line} to "&8[&7SPEC&8] &8%player%&8: &7%{_msg}%"
        loop {pof.arena.%{_id}%.players::*}:
            set {_t} to pofPlayer(loop-value)
            if {_t} is set:
                send {_line} to {_t}

on command:
    player is set
    set {_u} to UUID of player
    if {pof.player.arena::%{_u}%} is set:
        if player has permission "pof.admin":
            stop
        set {_c} to command
        if {_c} contains "give":
            cancel event
        if {_c} contains "gamemode":
            cancel event
        if {_c} contains "tp":
            cancel event
        if {_c} contains "teleport":
            cancel event
        if {_c} contains "enchant":
            cancel event
        if {_c} contains "effect":
            cancel event
